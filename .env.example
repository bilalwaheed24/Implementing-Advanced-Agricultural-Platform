# ---------------------------------------------------------------------------
# ABSP — example environment file.  Copy to .env and replace every placeholder.
# NEVER commit a real .env.  All values below are placeholders, not secrets.
# ---------------------------------------------------------------------------

# Runtime
ENV=development                      # development | test | production
APP_NAME=Agricultural Biotechnology Security Platform
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEMO_MODE=true                       # seeds and labels demonstration data

# Database  (SQLite for local demo; PostgreSQL for production)
DATABASE_URL=sqlite:///./absp.db
# DATABASE_URL=postgresql+psycopg://absp:CHANGE_ME@postgres:5432/absp

# Security — generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_48_byte_url_safe_random_string
JWT_ALGORITHM=HS256
JWT_KEY_ID=k1
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Application-layer encryption at rest — 32 bytes, base64
# python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key

# Device / IoT
DEVICE_TIMESTAMP_WINDOW_SECONDS=300
DEVICE_BACKFILL_WINDOW_SECONDS=86400
DEVICE_MAX_BATCH=500
# true  = the ingest response carries the anomaly verdict (best for demonstrations)
# false = scoring is deferred to a background task (roughly 10x single-node throughput)
TELEMETRY_INLINE_SCORING=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=120
PUBLIC_RATE_LIMIT_PER_MINUTE=30
MAX_BODY_BYTES=2097152
MAX_PAGE_SIZE=200

# CORS — comma separated, no wildcard in production
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Ledger
LEDGER_DATA_DIR=./ledger_data
DATA_DIR=.               # writable directory for demo artefacts (a volume in containers)
LEDGER_CHANNEL=agri-channel

# AI
AI_MODEL_DIR=./ai/models
ANOMALY_ALERT_THRESHOLD=0.65
FRAUD_SUSPECT_THRESHOLD=0.30
FRAUD_FAIL_THRESHOLD=0.70
MAX_SEQUENCE_LENGTH=100000

# IoT simulator
ABSP_API_URL=http://127.0.0.1:8000
